# Private AI Stack — environment template
# Copy to .env and edit. The pack's install.sh does this automatically.

# Your public hostname (DNS A record must point at this server BEFORE first start)
DOMAIN=ai.example.com
ACME_EMAIL=you@example.com

# Default model pulled on install. Small by design (runs on 4 GB RAM).
# Bigger options and hardware fit: see model-guide.md
OLLAMA_MODEL=llama3.2:3b

# Require login on the chat UI (leave true unless you know what you're doing)
WEBUI_AUTH=true
# Random secret for the UI session signing (Open WebUI 0.5.x+ requires it).
# install.sh generates one automatically if this is left blank.
WEBUI_SECRET_KEY=

# Backups (restic). Default is a local directory next to the compose file;
# host path is BACKUP_DIR, container path is RESTIC_REPOSITORY.
# For off-box backups replace RESTIC_REPOSITORY with e.g.
#   s3:s3.amazonaws.com/bucket/private-ai   (plus AWS_ACCESS_KEY_ID etc.)
#   b2:bucket:private-ai
#   sftp:user@host:/srv/backups/private-ai
BACKUP_DIR=./backups
RESTIC_REPOSITORY=/backups/private-ai
RESTIC_PASSWORD=change-me-to-a-long-passphrase

# Set to 1 to leave the firewall untouched during install.sh
# (use if your SSH port is not 22 or ufw is already managed elsewhere)
SKIP_FIREWALL=0
